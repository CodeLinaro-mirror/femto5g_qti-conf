From 065732aa92086bf2dfe0f9141b485c1640854af5 Mon Sep 17 00:00:00 2001
From: Nirmesh Kumar Singh <nkumarsi@codeaurora.org>
Date: Thu, 22 Oct 2020 11:51:42 +0530
Subject: [PATCH] __init__.py:remove this print to reduce warning messages

Change-Id: I54e91e135df45b9bfec2012961d2b5efba9a3060
Signed-off-by: Nirmesh Kumar Singh <nkumarsi@codeaurora.org>
---
 bitbake/lib/bb/fetch2/__init__.py | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/bitbake/lib/bb/fetch2/__init__.py b/bitbake/lib/bb/fetch2/__init__.py
index 03e5647..2654f3d 100644
--- a/bitbake/lib/bb/fetch2/__init__.py
+++ b/bitbake/lib/bb/fetch2/__init__.py
@@ -1193,9 +1193,7 @@ def get_checksum_file_list(d):
                     f = os.path.join(os.path.abspath(f), pth)
                 if f.startswith(dl_dir):
                     # The local fetcher's behaviour is to return a path under DL_DIR if it couldn't find the file anywhere else
-                    if os.path.exists(f):
-                        bb.warn("Getting checksum for %s SRC_URI entry %s: file not found except in DL_DIR" % (d.getVar('PN'), os.path.basename(f)))
-                    else:
+                    if not os.path.exists(f):
                         bb.warn("Unable to get checksum for %s SRC_URI entry %s: file could not be found" % (d.getVar('PN'), os.path.basename(f)))
                 filelist.append(f + ":" + str(os.path.exists(f)))
 
